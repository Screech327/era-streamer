{
  "name": "era-streamer",
  "productName": "ERA Streamer",
  "version": "0.25.0",
  "description": "ERA Rocket League broadcast overlay — desktop app",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "author": "Elite Rocket Association",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "puppeteer": "^24.43.1"
  },
  "build": {
    "appId": "com.eliterocketassociation.streamer",
    "productName": "ERA Streamer",
    "copyright": "Copyright © 2026 Elite Rocket Association",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "overlay/**/*",
      "ui/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "tray.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "ERA-Streamer-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ERA Streamer"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Screech327",
        "repo": "era-streamer"
      }
    ]
  }
}
